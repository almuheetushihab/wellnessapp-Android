        android:pathData="M 42,45 C 42,39.477 46.477,35 52,35 H 74 C 79.523,35 84,39.477 84,45 V 80 C 84,85.523 79.523,90 74,90 H 52 C 46.477,90 42,85.523 42,80 Z"
